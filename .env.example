APP_NAME="Mobilier Addict"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.mobilier-addict.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Abidjan

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobilier_addict
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = mails envoyés immédiatement (recommandé sans worker)
# database = nécessite un worker "php artisan queue:work" actif
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@mobilier-addict.com"
MAIL_FROM_NAME="Mobilier Addict"

VITE_APP_NAME="${APP_NAME}"
